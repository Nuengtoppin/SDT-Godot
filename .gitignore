# Original game binary and everything derived from it (regenerate with tools/swfconv, see README)
/original/
/extracted/
/game/assets/sdt/

# Godot
.godot/
*.import
!game/**/*.svg.import

# Tool environments
/tools/.venv/
__pycache__/
*.pyc

# Local Claude settings
/.claude/settings.local.json

# Native extension build outputs (build with scons in native/, see native/README.md)
/native/src/*.o
/native/.sconsign*.dblite
/game/bin/*.dll
/game/bin/*.a
/game/bin/*.so

# Mods folder used when running from the repo (Flash.mods_dir)
/Mods/
