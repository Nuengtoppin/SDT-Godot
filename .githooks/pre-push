#!/bin/sh
# Blocks a push when an outgoing commit or ref contains personal information.
#
# For every commit being pushed (not yet on any remote-tracking branch):
#   - author / committer email must be a no-reply address (*@users.noreply.github.com, noreply@*) and the commit
#     times must be in UTC (+0000)
#   - names, commit messages, changed file names and the full content of every added or changed file (binary files
#     too) must not match the patterns in .git/info/personal-patterns (one extended regex per line,
#     case-insensitive, '#' comments; the file is inside .git so it is never pushed: list real names, emails,
#     usernames and folder names there)
#   - commit messages and added text lines must not contain email addresses other than no-reply ones, or
#     user-profile paths
# Pushed ref names and annotated tags are checked against the patterns too. Any error blocks the push.
#
# Enable in a clone with:  git config core.hooksPath .githooks
# Bypass for one push (only if every match is a false positive):  git push --no-verify
# Fixing blocked commits: see README.md, "Contributing".

zero=0000000000000000000000000000000000000000
git_dir=$(git rev-parse --git-dir) || exit 1
patterns_file="$git_dir/info/personal-patterns"
hits=$(mktemp) || exit 1
trap 'rm -f "$hits"' EXIT

# Errors block the push: recorded as a hit too, since fail() may run in a pipeline subshell, where exit only
# leaves the subshell.
fail() {
	echo "  ERROR: $1" >> "$hits"
	echo "pre-push: $1 - push blocked." >&2
	exit 1
}
report() {
	echo "  $1" >> "$hits"
}

user_patterns=""
if [ -f "$patterns_file" ]; then
	user_patterns=$(grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$patterns_file" | paste -sd '|' -)
	if [ -n "$user_patterns" ]; then
		echo x | grep -Eiq "$user_patterns"
		[ $? -eq 2 ] && fail "invalid regex in $patterns_file"
	fi
else
	echo "pre-push: warning: no $patterns_file - only the built-in checks run." >&2
fi
builtin='[A-Za-z]:[\/]+Users[\/]+[^\/ "]+|/(home|Users)/[A-Za-z0-9_.-]+/|/[a-z]/Users/[A-Za-z0-9_.-]+'
email='[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'
noreply='(users\.noreply\.github\.com|noreply@[A-Za-z0-9.-]+|example\.(com|org|net))'

# grep exit status 2 (an error) must not pass silently; 0 / 1 (match / no match) are fine
scan() {   # scan <label> <regex> : reads stdin, reports matches
	out=$(grep -a -Eio -- "$2")
	st=$?
	[ $st -eq 2 ] && fail "grep failed while checking $1"
	[ -n "$out" ] && printf '%s\n' "$out" | sort -u | while read -r m; do report "$1: $m"; done
	return 0
}

check_commit() {
	c=$1
	short=$(git rev-parse --short "$c") || fail "cannot read commit $c"
	meta=$(git log -1 --format='%an%n%ae%n%cn%n%ce%n%ai%n%ci' "$c") || fail "cannot read commit $c"
	for e in $(git log -1 --format='%ae %ce' "$c"); do
		echo "$e" | grep -Eqi "$noreply" || report "$short: author/committer email $e is not a no-reply address"
	done
	for d in $(git log -1 --format='%ad|%cd' --date=format:%z "$c" | tr '|' ' '); do
		[ "$d" = "+0000" ] || report "$short: commit time zone $d is not UTC (commit with TZ=UTC)"
	done
	msg=$(git log -1 --format=%B "$c")
	# first parent only: for a merge, what it brings in relative to the branch it was merged into
	parent=$(git rev-parse -q --verify "$c^1" 2>/dev/null)
	if [ -n "$parent" ]; then
		names=$(git diff --name-only --no-renames "$parent" "$c") || fail "cannot diff $short"
		blobs=$(git diff --raw --no-renames --no-abbrev "$parent" "$c" | awk '$4 !~ /^0+$/ {print $4}') || fail "cannot diff $short"
		added=$(git diff --no-ext-diff --no-textconv --no-color --unified=0 "$parent" "$c" | grep '^+' | grep -v '^+++ ')
	else
		names=$(git ls-tree -r --name-only "$c") || fail "cannot list $short"
		blobs=$(git ls-tree -r "$c" | awk '$2 == "blob" {print $3}')
		added=$(git show --format= --no-ext-diff --no-textconv --no-color --unified=0 "$c" | grep '^+' | grep -v '^+++ ')
	fi
	if [ -n "$user_patterns" ]; then
		printf '%s\n%s\n%s\n' "$meta" "$msg" "$names" | scan "$short: personal pattern" "$user_patterns"
		if [ -n "$blobs" ]; then
			printf '%s\n' "$blobs" | git cat-file --batch | scan "$short: personal pattern in file content" "$user_patterns"
		fi
	fi
	printf '%s\n%s\n%s\n' "$msg" "$names" "$added" | scan "$short: user-profile path" "$builtin"
	printf '%s\n%s\n' "$msg" "$added" | grep -a -Eo "$email" | grep -Evi "$noreply" | sort -u | while read -r m; do
		report "$short: email address: $m"
	done
}

while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue   # deleting a ref
	if [ -n "$user_patterns" ]; then
		printf '%s\n%s\n' "$local_ref" "$remote_ref" | scan "ref name" "$user_patterns"
	fi
	if [ "$(git cat-file -t "$local_sha" 2>/dev/null)" = "tag" ]; then
		tag=$(git cat-file tag "$local_sha") || fail "cannot read tag $local_ref"
		[ -n "$user_patterns" ] && printf '%s\n' "$tag" | scan "tag $local_ref" "$user_patterns"
		printf '%s\n' "$tag" | grep -Eo "$email" | grep -Evi "$noreply" | sort -u | while read -r m; do
			report "tag $local_ref: email address: $m"
		done
	fi
	if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
		commits=$(git rev-list "$local_sha" --not "$remote_sha" --remotes) || fail "cannot list commits for $local_ref"
	else
		commits=$(git rev-list "$local_sha" --not --remotes) || fail "cannot list commits for $local_ref"
	fi
	for c in $commits; do
		check_commit "$c"
	done
done

[ -s "$hits" ] || exit 0
echo "pre-push: personal information found in what is being pushed:" >&2
sort -u "$hits" >&2
echo "Push blocked. Fix those commits first (see README.md, Contributing), or use 'git push --no-verify' if every" >&2
echo "match is a false positive." >&2
exit 1
