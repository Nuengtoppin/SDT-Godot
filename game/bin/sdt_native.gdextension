[configuration]

entry_symbol = "sdt_native_init"
compatibility_minimum = "4.7"

[libraries]

windows.debug.x86_64 = "res://bin/sdt_native.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/sdt_native.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/sdt_native.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/sdt_native.linux.template_release.x86_64.so"
